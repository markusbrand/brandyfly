# Host port exposed on the Raspberry Pi (mapped to container port 8080).
# Default: 8090
BRANDYFLY_HOST_PORT=8090

# Address the backend listens on inside the container.
# Default: :8080 (all interfaces, port 8080)
# Only change this if you need to bind to a specific interface inside the container.
BRANDYFLY_LISTEN_ADDRESS=:8080
