{
  "version": 8,
  "name": "BrandyFly Alpine Relief",
  "metadata": {
    "brandyfly:style": "alpine_relief",
    "brandyfly:description": "OpenStreetMap OpenMapTiles vector style with hillshade, terrain relief, forests, meadows, rocks, water, trails, aerialways, and peaks."
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://assets/map_data/global_overview.pmtiles"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "pmtiles://terrain.pmtiles",
      "tileSize": 256,
      "encoding": "terrarium"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2efe9"
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-illumination-direction": 315,
        "hillshade-exaggeration": 0.8,
        "hillshade-shadow-color": "#3d332a",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#000000"
      }
    },
    {
      "id": "landcover-glacier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "glacier", "ice"],
      "paint": {
        "fill-color": "#e8f4f8",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landcover-rock",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "rock", "bare_rock", "scree", "cliff"],
      "paint": {
        "fill-color": "#dedad5",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": {
        "fill-color": "#d2e8cb",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landuse-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "wood", "forest"],
      "paint": {
        "fill-color": "#d2e8cb",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "meadow", "scrub", "heath", "grassland"],
      "paint": {
        "fill-color": "#e2f0d9",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "landuse-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "grass", "meadow", "scrub", "heath"],
      "paint": {
        "fill-color": "#e2f0d9",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "commercial", "industrial", "suburb"],
      "paint": {
        "fill-color": "#e8e5df",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#aad3df",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", "class", "river"],
      "paint": {
        "line-color": "#9bcad6",
        "line-width": 1.8
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["in", "class", "stream", "canal", "ditch"],
      "paint": {
        "line-color": "#aad3df",
        "line-width": 1.0
      }
    },
    {
      "id": "road-highway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#cf603a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 2.0,
          10, 4.5,
          14, 8.5
        ]
      }
    },
    {
      "id": "road-highway-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#fdbf6f",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 1.2,
          10, 3.0,
          14, 6.5
        ]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#d48834",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7, 1.8,
          11, 3.5,
          14, 6.0
        ]
      }
    },
    {
      "id": "road-major-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#fdd6a4",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7, 1.0,
          11, 2.5,
          14, 4.5
        ]
      }
    },
    {
      "id": "road-medium",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 1.0,
          12, 2.0,
          14, 3.5
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "minzoom": 11,
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.0,
          14, 2.2
        ]
      }
    },
    {
      "id": "road-track",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "track"],
      "minzoom": 11,
      "paint": {
        "line-color": "#8c7256",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.0,
          14, 2.0
        ],
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "minzoom": 11,
      "paint": {
        "line-color": "#b34d28",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.0,
          14, 1.8
        ],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-aerialway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "aerialway"],
        ["in", "subclass", "cable_car", "gondola", "chair_lift", "drag_lift"]
      ],
      "minzoom": 10,
      "paint": {
        "line-color": "#2c2c2c",
        "line-width": 1.4,
        "line-dasharray": [5, 3]
      }
    },
    {
      "id": "road-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "rail", "transit"],
      "minzoom": 9,
      "paint": {
        "line-color": "#666666",
        "line-width": 1.5,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "boundary-country-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["in", "admin_level", 2, 4],
      "paint": {
        "line-color": "#8b6b9e",
        "line-width": 1.0,
        "line-dasharray": [4, 3],
        "line-opacity": 0.6
      }
    },
    {
      "id": "mountain-peak-point",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "filter": ["has", "name"],
      "minzoom": 12,
      "paint": {
        "circle-radius": 3.0,
        "circle-color": "#633816",
        "circle-stroke-width": 1.2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "mountain-peak-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "filter": ["has", "name"],
      "minzoom": 12,
      "layout": {
        "text-field": "{name}\n{ele}m",
        "text-size": 10,
        "text-offset": [0, 1.1],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#4a2810",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-omt-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village", "hamlet"],
      "layout": {
        "text-field": "{name}",
        "text-size": 11
      },
      "paint": {
        "text-color": "#2c2c2c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
