{
  "version": 8,
  "name": "BrandyFly OpenStreetMap",
  "metadata": {
    "brandyfly:style": "alpine_relief",
    "brandyfly:description": "OpenStreetMap vector style with forests, pastures, rocks, water, buildings, roads, trails, aerialways, and peaks."
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://assets/map_data/global_overview.pmtiles"
    },
    "terrain": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "tileSize": 512,
      "maxzoom": 15,
      "encoding": "terrarium"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2efe9"
      }
    },
    {
      "id": "landuse-glacier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "kind", "glacier"],
      "paint": {
        "fill-color": "#e8f4f8",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse-bare-rock",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "kind", "bare_rock", "scree", "cliff"],
      "paint": {
        "fill-color": "#dedad5"
      }
    },
    {
      "id": "landuse-forest",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "kind", "forest", "wood"],
      "paint": {
        "fill-color": "#d2e8cb",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landcover-forest-fallback",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#d2e8cb",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "landuse-meadow",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "kind", "meadow", "grass", "grassland", "scrub", "heath"],
      "paint": {
        "fill-color": "#e2f0d9"
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "kind", "residential", "commercial", "industrial"],
      "paint": {
        "fill-color": "#e8e5df"
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-illumination-direction": 315,
        "hillshade-exaggeration": 0.75,
        "hillshade-shadow-color": "#2c3e50",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#4a6345"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#aad3df",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["in", "kind", "river", "waterway"],
      "paint": {
        "line-color": "#9bcad6",
        "line-width": 1.5
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["in", "kind_detail", "stream", "canal", "ditch"],
      "paint": {
        "line-color": "#aad3df",
        "line-width": 1.0
      }
    },
    {
      "id": "waterway-fallback",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#9bcad6",
        "line-width": 1.5
      }
    },
    {
      "id": "buildings-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "minzoom": 12,
      "paint": {
        "fill-color": "#d9d0c9",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "buildings-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "buildings",
      "minzoom": 12,
      "paint": {
        "line-color": "#c4bcb2",
        "line-width": 0.75
      }
    },
    {
      "id": "road-highway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "highway"],
      "paint": {
        "line-color": "#cf603a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 2.0,
          10, 4.5,
          14, 8.5
        ]
      }
    },
    {
      "id": "road-highway-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "highway"],
      "paint": {
        "line-color": "#fdbf6f",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 1.2,
          10, 3.0,
          14, 6.5
        ]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "major_road"],
      "paint": {
        "line-color": "#d48834",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7, 1.8,
          11, 3.5,
          14, 6.0
        ]
      }
    },
    {
      "id": "road-major-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "major_road"],
      "paint": {
        "line-color": "#fdd6a4",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7, 1.0,
          11, 2.5,
          14, 4.5
        ]
      }
    },
    {
      "id": "road-medium-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "medium_road"],
      "paint": {
        "line-color": "#b0aba2",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 1.5,
          12, 3.0,
          14, 5.0
        ]
      }
    },
    {
      "id": "road-medium-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "medium_road"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8, 1.0,
          12, 2.0,
          14, 3.5
        ]
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["in", "kind", "minor_road", "service"],
      "minzoom": 11,
      "paint": {
        "line-color": "#cfcac2",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.5,
          14, 3.5
        ]
      }
    },
    {
      "id": "road-minor-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["in", "kind", "minor_road", "service"],
      "minzoom": 11,
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.0,
          14, 2.5
        ]
      }
    },
    {
      "id": "road-track",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind_detail", "track"],
      "minzoom": 11,
      "paint": {
        "line-color": "#8c7256",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.0,
          14, 2.0
        ],
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["in", "kind_detail", "path", "footway", "cycleway"],
      "minzoom": 11,
      "paint": {
        "line-color": "#b34d28",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11, 1.0,
          14, 1.8
        ],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-path-general",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": [
        "all",
        ["==", "kind", "path"],
        ["!in", "kind_detail", "track", "path", "footway", "cycleway"]
      ],
      "minzoom": 11,
      "paint": {
        "line-color": "#a86440",
        "line-width": 1.2,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "road-aerialway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "aerialway"],
      "minzoom": 10,
      "paint": {
        "line-color": "#2c2c2c",
        "line-width": 1.4,
        "line-dasharray": [5, 3]
      }
    },
    {
      "id": "road-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "roads",
      "filter": ["==", "kind", "rail"],
      "minzoom": 9,
      "paint": {
        "line-color": "#666666",
        "line-width": 1.5,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "omt-roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#d48834",
        "line-width": 2.5
      }
    },
    {
      "id": "omt-roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary", "minor", "service"],
      "minzoom": 11,
      "paint": {
        "line-color": "#ffffff",
        "line-width": 1.5
      }
    },
    {
      "id": "earth-cliff",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "earth",
      "filter": ["==", "kind", "cliff"],
      "minzoom": 11,
      "paint": {
        "line-color": "#78746e",
        "line-width": 1.2
      }
    },
    {
      "id": "boundary-country-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#8b6b9e",
        "line-width": 1.0,
        "line-dasharray": [4, 3],
        "line-opacity": 0.6
      }
    },
    {
      "id": "contour-100m",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "filter": ["==", ["%", ["to-number", ["get", "elevation"]], 100], 0],
      "minzoom": 10,
      "paint": {
        "line-color": "#8b6c42",
        "line-opacity": 0.6,
        "line-width": 1.4
      }
    },
    {
      "id": "contour-50m",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "filter": [
        "all",
        ["==", ["%", ["to-number", ["get", "elevation"]], 50], 0],
        ["!=", ["%", ["to-number", ["get", "elevation"]], 100], 0]
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "#8b6c42",
        "line-opacity": 0.35,
        "line-width": 0.9
      }
    },
    {
      "id": "contour-10m",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "filter": ["!=", ["%", ["to-number", ["get", "elevation"]], 50], 0],
      "minzoom": 14,
      "paint": {
        "line-color": "#8b6c42",
        "line-opacity": 0.2,
        "line-width": 0.6
      }
    },
    {
      "id": "contour-100m-label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contours",
      "filter": ["==", ["%", ["to-number", ["get", "elevation"]], 100], 0],
      "minzoom": 12,
      "layout": {
        "text-field": "{elevation}m",
        "text-size": 9,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#6b5a3e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "peak-points",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "pois",
      "filter": ["==", "kind", "peak"],
      "paint": {
        "circle-radius": 3.5,
        "circle-color": "#8b4513",
        "circle-stroke-width": 1.5,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "peak-omt-points",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "paint": {
        "circle-radius": 3.5,
        "circle-color": "#8b4513",
        "circle-stroke-width": 1.5,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "peaks-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "pois",
      "filter": ["==", "kind", "peak"],
      "layout": {
        "text-field": "{name}",
        "text-size": 11,
        "text-offset": [0, 1.2],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#4a2810",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "places",
      "filter": ["in", "kind", "city", "town", "village", "locality"],
      "layout": {
        "text-field": "{name}",
        "text-size": 11
      },
      "paint": {
        "text-color": "#2c2c2c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-omt-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "village"],
      "layout": {
        "text-field": "{name}",
        "text-size": 11
      },
      "paint": {
        "text-color": "#2c2c2c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
